# Splitdev environment variables. Copy to .env.local for local development.
# Never commit real values: .env and .env.* are gitignored (except this file).

# ── Solana RPC ────────────────────────────────────────────────────────
# Browser RPC (reads, quotes, sending signed transactions).
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
# Server RPC; must allow getProgramAccounts (coin discovery on pump.fun's fee program).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Site URLs (sitemap, robots, share cards) ─────────────────────────
SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── GitHub lookups ────────────────────────────────────────────────────
# Optional. Any token with no scopes raises the REST limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# ── Coin images and metadata ─────────────────────────────────────────
# Vercel Blob store (Vercel sets it when the store is connected).
BLOB_READ_WRITE_TOKEN=
# Optional IPFS uploads via Pinata instead of Blob.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
# "memory" keeps metadata in process memory (local end-to-end tests only).
SPLIDEV_METADATA_STORE=

# ── Overrides of src/splidev.json (tests) ────────────────────────────
# Public treasury address, platform share in basis points, launch fee in SOL.
NEXT_PUBLIC_SPLIDEV_TREASURY=
NEXT_PUBLIC_SPLIDEV_PLATFORM_BPS=
NEXT_PUBLIC_SPLIDEV_LAUNCH_FEE_SOL=

# ── Rate limiting ─────────────────────────────────────────────────────
# Header that carries the client IP on hosts other than Vercel/Render (e.g. cf-connecting-ip).
TRUSTED_IP_HEADER=

# ── Networks ──────────────────────────────────────────────────────────
# The site serves Robinhood Chain mainnet (4663) and testnet (46630) at once; visitors pick one at
# the top of the page. Contract addresses live in src/deployment.json; these override them.
# Where visitors land first: "mainnet" or "testnet" (default: mainnet once it's live, else testnet).
NEXT_PUBLIC_DEFAULT_NETWORK=
# Optional custom RPCs (e.g. Alchemy). Default to each chain's public endpoint.
NEXT_PUBLIC_MAINNET_RPC_URL=
NEXT_PUBLIC_TESTNET_RPC_URL=
# Pins (set both per network, or neither), normally committed to src/deployment.json instead.
NEXT_PUBLIC_MAINNET_LAUNCHER_ADDRESS=
NEXT_PUBLIC_MAINNET_FEE_VAULT_ADDRESS=
NEXT_PUBLIC_TESTNET_LAUNCHER_ADDRESS=
NEXT_PUBLIC_TESTNET_FEE_VAULT_ADDRESS=
NEXT_PUBLIC_TESTNET_PONS_FACTORY=
# Coins not listed on the site (comma-separated addresses)
NEXT_PUBLIC_MAINNET_HIDDEN_COINS=
NEXT_PUBLIC_TESTNET_HIDDEN_COINS=

# https://cloud.reown.com (WalletConnect). Browser wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Server ────────────────────────────────────────────────────────────
# Signs launch attestations and fee claims on both networks; FeeVault.signer must be its address.
# Generate it on /setup in your browser and paste it here. It holds no funds and owns nothing.
# Server-side only; never commit it.
SIGNER_PRIVATE_KEY=
# ...or a random seed the key is derived from (Render can generate it: SIGNER_SEED generateValue)
SIGNER_SEED=

# next-auth: public URL of the site and a random secret (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# X (Twitter) OAuth 2.0 app for "Sign in with X" (https://developer.x.com)
#   Type: Web App, callback URL: {NEXTAUTH_URL}/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Username → X user id lookup:
#   x-api     official API, needs X_BEARER_TOKEN (Basic tier or above)
#   fxtwitter free public mirror (default when no bearer token is set)
X_RESOLVER=
X_BEARER_TOKEN=

# Optional image uploads to IPFS via Pinata (https://app.pinata.cloud → API keys → JWT)
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Wallets allowed into /setup (comma-separated public addresses). The on-chain owner of each
# pinned launcher is allowed too.
ADMIN_ADDRESSES=
# Vercel Blob store for coin images uploaded from files (Vercel sets it when the store is connected).
BLOB_READ_WRITE_TOKEN=

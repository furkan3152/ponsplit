# Real Solana mainnet endpoints. Keep the server endpoint private.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Public keys from the deployed escrow and the external verifier signer.
NEXT_PUBLIC_TIKSPLIT_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_TIKSPLIT_VERIFIER=
# TikTok Developer Portal: Login Kit, user.info.basic + user.info.profile.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/callback
# At least 32 random bytes, kept in the hosting secret manager.
TIKTOK_SESSION_SECRET=
# HTTPS signer API backed by your managed signing service. No private key in this app.
TIKTOK_ATTESTATION_URL=
TIKTOK_ATTESTATION_TOKEN=
# Durable image/metadata storage: configure Blob or Pinata.
BLOB_READ_WRITE_TOKEN=
PINATA_JWT=
SITE_URL=https://your-domain.example

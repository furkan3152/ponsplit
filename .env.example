# ── Chain ─────────────────────────────────────────────────────────────
# "testnet" (Robinhood Chain testnet, 46630), "mainnet" (4663) or "local" (Hardhat 31337)
NEXT_PUBLIC_CHAIN=testnet
# Optional custom RPC (e.g. Alchemy). Defaults to the chain's public endpoint.
NEXT_PUBLIC_RPC_URL=

# From contracts/deployments/<network>.json
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_FEE_VAULT_ADDRESS=

# https://cloud.reown.com (WalletConnect). Browser wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Server ────────────────────────────────────────────────────────────
# Signs launch attestations and fee claims. Its address must equal FeeVault.signer
# (CLAIM_SIGNER_ADDRESS at deploy time). Server-side only; never commit it.
SIGNER_PRIVATE_KEY=

# next-auth: public URL of the site and a random secret (openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# X (Twitter) OAuth 2.0 app for "Sign in with X" (https://developer.x.com)
#   Type: Web App, callback URL: {NEXTAUTH_URL}/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Username → X user id lookup:
#   x-api     official API, needs X_BEARER_TOKEN (Basic tier or above)
#   fxtwitter free public mirror (default when no bearer token is set)
#   mock      fake ids for local development only
X_RESOLVER=
X_BEARER_TOKEN=

# Optional image uploads to IPFS via Pinata (https://app.pinata.cloud → API keys → JWT)
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Local development only: fake "Sign in with X" (requires X_RESOLVER=mock)
ENABLE_DEV_LOGIN=

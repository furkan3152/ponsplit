# Public production origin: HTTPS, no path/query/hash.
SITE_URL=https://your-domain.example

# Solana mainnet RPC. Existing production RPC/storage settings can be retained.
# Keep paid server RPC credentials private.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Default manual video verification: admin signs approvals in their wallet.
# These are PUBLIC addresses. No owner private key or seed belongs in this app.
NEXT_PUBLIC_TIKSPLIT_ADMIN_WALLET=D2Ts7yCiVjedo6uwqpkM44QA8J45NdVU1J3k5m6iWtvm
NEXT_PUBLIC_TIKSPLIT_VERIFIER=D2Ts7yCiVjedo6uwqpkM44QA8J45NdVU1J3k5m6iWtvm
# Set after deploying the current manual-verification program to mainnet.
NEXT_PUBLIC_TIKSPLIT_ESCROW_PROGRAM_ID=

# Durable token images/metadata: at least one provider (existing Blob or Pinata).
BLOB_READ_WRITE_TOKEN=
PINATA_JWT=

# OPTIONAL server admin session: needed for protected server configuration mutations.
# Default wallet-signed deployment/review/financial actions do NOT require Redis.
# At least 32 random bytes, kept in the hosting secret manager.
ADMIN_SESSION_SECRET=
# Required in production IF using server admin sessions / Vercel configuration API.
ADMIN_REPLAY_REDIS_REST_URL=
ADMIN_REPLAY_REDIS_REST_TOKEN=

# OPTIONAL automatic Vercel environment update + production rebuild.
# Server-only token: never NEXT_PUBLIC_* and never stored in the browser.
# Without it, set verified public values in Vercel and rebuild manually.
VERCEL_DEPLOY_TOKEN=
VERCEL_PROJECT_ID=prj_K4lYPXiOoIIqWqjNvaJxqqiuBeJI
VERCEL_TEAM_ID=

# OPTIONAL future TikTok Login Kit flow. NOT required for manual video proof today.
# Requires an approved app/scopes and correctly configured external attestation service.
# Callback and SITE_URL must use the same public origin. Secrets remain server-only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-domain.example/api/tiktok/callback
# At least 32 random bytes when the optional OAuth flow is enabled.
TIKTOK_SESSION_SECRET=
TIKTOK_ATTESTATION_URL=
TIKTOK_ATTESTATION_TOKEN=

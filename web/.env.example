# "testnet" (Robinhood Chain testnet, 46630) or "mainnet" (Robinhood Chain, 4663)
NEXT_PUBLIC_CHAIN=testnet
# Optional custom RPC (e.g. Alchemy). Defaults to the public endpoint for the chain.
NEXT_PUBLIC_RPC_URL=

# From contracts/deployments/<network>.json
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=
NEXT_PUBLIC_FEE_VAULT_ADDRESS=

# https://cloud.reown.com (WalletConnect) project id
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# next-auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# X (Twitter) OAuth 2.0 app: https://developer.x.com, callback URL:
#   {NEXTAUTH_URL}/api/auth/callback/twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Private key that signs fee claims. Its address must match FeeVault.signer. Keep it server-side only.
SIGNER_PRIVATE_KEY=
